# DeepSeek API key (required for balance)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# Platform session token (optional, for usage stats)
# Get it from DevTools → Application → Local Storage → platform.deepseek.com
DEEPSEEK_PLATFORM_TOKEN=

# Poll intervals in seconds
DEEPSEEK_BALANCE_SECS=30
DEEPSEEK_USAGE_SECS=900
